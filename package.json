{
  "name": "portfolio",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "Rudra Prasadh Ganesh: a hand-made single-page site drawn as an engineering sheet.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && vite build",
    "structured-data": "node scripts/structured-data.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
